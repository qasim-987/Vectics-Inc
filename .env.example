# Email delivery for the website contact form (Resend).
# Create an API key and verify the sending domain in your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Vectis Website <website@your-verified-domain.example>
CONTACT_TO_EMAIL=hello@vectisoperations.tech

# --- Bulk email campaigns (scripts/email-campaign.mjs + /api/unsubscribe) ---
# Long random string (32+ chars). Signs unsubscribe links; rotating it
# invalidates links in emails that have already gone out.
EMAIL_UNSUBSCRIBE_SECRET=
# Public origin used to build absolute unsubscribe URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vectisoperations.tech
# Optional: persistent suppression store for unsubscribes (see supabase/email-schema.sql).
# Server-only. Never expose the service-role key through a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
