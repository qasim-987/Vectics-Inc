{
  "name": "anti-quanta",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:palette": "node test_color_palette.js",
    "campaign": "node scripts/email-campaign.mjs",
    "campaign:dry": "node scripts/email-campaign.mjs --contacts campaigns/contacts.example.csv --template campaigns/templates/example.json",
    "campaign:tags": "node scripts/email-campaign.mjs --contacts campaigns/contacts.example.csv --template campaigns/templates/example.json --list-tags",
    "check:unsubscribe-token": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-unsubscribe-token.mjs",
    "test": "npm run check:unsubscribe-token"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
